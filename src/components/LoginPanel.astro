---
// src/components/auth/LoginPanel.astro
---

<div class="hidden lg:flex relative overflow-hidden flex-col justify-center items-center px-14 py-16 bg-[#6C9BB5]">

  <!-- Pompas decorativos -->
  <div class="absolute w-[500px] h-[500px] rounded-full bg-white/[.06] -top-32 -right-32"></div>
  <div class="absolute w-[360px] h-[360px] rounded-full bg-white/[.05] -bottom-24 -left-24"></div>
  <div class="absolute w-[220px] h-[220px] rounded-full bg-white/[.04] top-1/2 left-[28%] -translate-x-1/2 -translate-y-1/2"></div>

  <div class="relative z-10 text-center text-white max-w-[380px]">

    <!-- Logo -->
    <div class="w-[76px] h-[76px] flex items-center justify-center mx-auto mb-2">
  <img src="/public/kinvia-logo-white.webp" alt="Kinvia" class="w-full h-full object-contain" />
    </div>

    <p class="text-[12px] font-bold tracking-[3px] uppercase text-white/55 mb-[18px]">Kinvia</p>
    <h2 class="text-[34px] font-black leading-[1.15] mb-4">Cuidar en familia,<br>sin esfuerzo extra</h2>
    <p class="text-[15px] font-medium text-white/70 leading-[1.65] mb-10">
      Coordina tareas, citas y notas con todo el equipo de cuidado en un solo lugar.
    </p>

    <!-- Features -->
    <div class="flex flex-col gap-[14px]">

      <div class="flex items-center gap-[14px] bg-white/10 rounded-2xl px-[18px] py-[14px] backdrop-blur-sm text-left">
        <div class="w-9 h-9 bg-white/[.18] rounded-[10px] flex items-center justify-center shrink-0 text-white">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <div>
          <p class="text-[13px] font-extrabold text-white">Tareas compartidas</p>
          <p class="text-[12px] font-normal text-white/60 mt-0.5">Asigna y da seguimiento a cada tarea del cuidado</p>
        </div>
      </div>

      <div class="flex items-center gap-[14px] bg-white/10 rounded-2xl px-[18px] py-[14px] backdrop-blur-sm text-left">
        <div class="w-9 h-9 bg-white/[.18] rounded-[10px] flex items-center justify-center shrink-0 text-white">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div>
          <p class="text-[13px] font-extrabold text-white">Calendario de citas</p>
          <p class="text-[12px] font-normal text-white/60 mt-0.5">Nunca más una cita médica olvidada</p>
        </div>
      </div>

      <div class="flex items-center gap-[14px] bg-white/10 rounded-2xl px-[18px] py-[14px] backdrop-blur-sm text-left">
        <div class="w-9 h-9 bg-white/[.18] rounded-[10px] flex items-center justify-center shrink-0 text-white">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <p class="text-[13px] font-extrabold text-white">Equipo de cuidado</p>
          <p class="text-[12px] font-normal text-white/60 mt-0.5">Toda la familia coordinada y al día</p>
        </div>
      </div>

    </div>
  </div>
</div>