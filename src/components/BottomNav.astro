---
export interface Props {
  active?: "inicio" | "calendario" | "tareas" | "notas" | "grupo";
}
const { active = "inicio" } = Astro.props;

const items = [
  {
    key: "inicio",
    label: "Inicio",
    href: "/dashboard",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    key: "calendario",
    label: "Calendario",
    href: "/calendario",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  },
  {
    key: "tareas",
    label: "Tareas",
    href: "/tareas",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
  },
  {
    key: "notas",
    label: "Notas",
    href: "/notas",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    key: "grupo",
    label: "Grupo",
    href: "/grupo",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];
---

<nav class="bottom-nav">
  {items.map((item) => (
    <a href={item.href} class={`nav-item ${active === item.key ? "nav-active" : ""}`}>
      <span class="nav-icon" set:html={item.icon} />
      <span class="nav-label">{item.label}</span>
      {active === item.key && <span class="nav-dot" />}
    </a>
  ))}
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 68px;
    background: var(--white);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 4px;
    z-index: 100;
    box-shadow: 0 -4px 24px rgba(108, 155, 181, 0.10);
  }

  .nav-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-decoration: none;
    color: var(--text-muted);
    padding: 8px 14px;
    border-radius: 12px;
    transition: color 0.2s, background 0.2s;
    flex: 1;
  }
  .nav-item:hover {
    color: var(--blue);
    background: var(--blue-bg-soft);
  }
  .nav-active {
    color: var(--blue) !important;
  }

  .nav-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-icon :global(svg) {
    width: 22px;
    height: 22px;
    stroke: currentColor;
  }

  .nav-label {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* Punto indicador bajo el ítem activo */
  .nav-dot {
    position: absolute;
    bottom: 4px;
    width: 4px;
    height: 4px;
    background: var(--blue);
    border-radius: 50%;
  }
</style>
