---
export interface Props {
  title: string;
  description: string;
  datetime: string;
  tag: string;
}
const { title, description, datetime, tag } = Astro.props;
---

<div class="event-item">
  <div class="event-icon">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
  </div>
  <div class="event-info">
    <span class="event-title">{title}</span>
    <span class="event-desc">{description}</span>
    <span class="event-date">{datetime}</span>
  </div>
  <span class="event-tag">{tag}</span>
</div>

<style>
  .event-item {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 0;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .event-item:not(:last-child) {
    border-bottom: 1px solid var(--border);
  }
  .event-item:hover {
    background: var(--blue-bg-soft);
    border-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 0 -10px;
  }

  .event-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    background: var(--blue-bg);
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
  }
  .event-icon svg { width: 17px; height: 17px; }

  .event-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .event-title {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .event-desc {
    font-size: 0.77rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .event-date {
    font-size: 0.70rem;
    color: var(--text-muted);
    font-weight: 700;
    margin-top: 1px;
  }

  .event-tag {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 4px 11px;
    border-radius: 20px;
    background: var(--blue-bg);
    color: var(--blue-darker);
    border: 1px solid #c8dfe9;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
