---
export interface Props {
  title: string;
  description: string;
  date: string;
  status: "en_curso" | "pendiente" | "completada";
}
const { title, description, date, status } = Astro.props;

const statusLabel: Record<string, string> = {
  en_curso:   "En curso",
  pendiente:  "Pendiente",
  completada: "Completada",
};
---

<div class="task-item">
  <div class={`task-check check-${status}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      {status === "completada"
        ? <polyline points="20 6 9 17 4 12" />
        : <rect x="3" y="3" width="18" height="18" rx="4" />
      }
    </svg>
  </div>
  <div class="task-info">
    <span class={`task-title ${status === "completada" ? "done" : ""}`}>{title}</span>
    <span class="task-desc">{description}</span>
    <span class="task-date">{date}</span>
  </div>
  <span class={`task-badge badge-${status}`}>{statusLabel[status]}</span>
</div>

<style>
  .task-item {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s ease;
    border-radius: 0;
  }
  .task-item:last-child { border-bottom: none; }
  .task-item:hover {
    background: var(--blue-bg-soft);
    border-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 0 -10px;
    border-bottom-color: transparent;
  }

  .task-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    transition: color 0.2s;
  }
  .check-en_curso  { color: var(--blue); }
  .check-pendiente { color: var(--text-muted); }
  .check-completada { color: var(--blue-dark); }
  .task-check svg  { width: 22px; height: 22px; }

  .task-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .task-title {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .task-title.done {
    text-decoration: line-through;
    color: var(--text-muted);
  }
  .task-desc {
    font-size: 0.77rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .task-date {
    font-size: 0.70rem;
    color: var(--text-muted);
    font-weight: 700;
    margin-top: 1px;
  }

  /* Badges */
  .task-badge {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 4px 11px;
    border-radius: 20px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .badge-en_curso {
    background: var(--text-primary);
    color: #fff;
  }
  .badge-pendiente {
    background: #f0edf8;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .badge-completada {
    background: #d4eef7;
    color: var(--blue-darker);
  }
</style>
