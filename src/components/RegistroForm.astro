---
// src/components/RegisterForm.astro
---

<div class="flex items-center justify-center px-5 py-10 bg-[#faf8ff] md:px-10 lg:px-16 xl:px-20 lg:overflow-y-auto">
  <div class="w-full max-w-[400px] md:max-w-[440px] lg:max-w-[420px]">

    <h1 class="text-[24px] md:text-[28px] lg:text-[30px] font-black text-[#1a1a2e] leading-tight mb-1">
      Crea tu cuenta
    </h1>
    <p class="text-sm md:text-[15px] font-medium text-[#6b6b8a] mb-6 leading-relaxed">
      Empieza a coordinar el cuidado en familia
    </p>

    <!-- Error banner -->
    <div id="errorMsg" role="alert" aria-live="polite"
      class="hidden items-center gap-2 bg-[#fff1f3] border-2 border-[#ffd0d8] rounded-xl px-4 py-3 mb-5 text-[13px] font-semibold text-[#e03b5a]">
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span id="errorText">Error al crear la cuenta</span>
    </div>

    <!-- Success banner -->
    <div id="successMsg" role="status" aria-live="polite"
      class="hidden items-center gap-2 bg-[#f0fdf4] border-2 border-[#bbf7d0] rounded-xl px-4 py-3 mb-5 text-[13px] font-semibold text-[#166534]">
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span>¡Cuenta creada con éxito! Redirigiendo...</span>
    </div>

    <!-- Nombre completo -->
    <div class="mb-4">
      <label for="fullname" class="block text-[13px] font-bold text-[#1a1a2e] mb-2">Nombre completo</label>
      <div class="relative">
        <input type="text" id="fullname" placeholder="María González"
          autocomplete="name" required
          class="input-field w-full pl-11 pr-4 py-3.5 border-2 border-[#e8e0f5] rounded-[13px] text-[15px] font-semibold text-[#1a1a2e] bg-white placeholder:text-[#a0a0bb] placeholder:font-medium transition-all duration-200 outline-none" />
        <span class="input-icon absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a0a0bb] flex items-center pointer-events-none transition-colors duration-200">
          <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </span>
      </div>
    </div>

    <!-- Email -->
    <div class="mb-4">
      <label for="email" class="block text-[13px] font-bold text-[#1a1a2e] mb-2">Correo electrónico</label>
      <div class="relative">
        <input type="email" id="email" placeholder="maria@ejemplo.com"
          autocomplete="email" required
          class="input-field w-full pl-11 pr-4 py-3.5 border-2 border-[#e8e0f5] rounded-[13px] text-[15px] font-semibold text-[#1a1a2e] bg-white placeholder:text-[#a0a0bb] placeholder:font-medium transition-all duration-200 outline-none" />
        <span class="input-icon absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a0a0bb] flex items-center pointer-events-none transition-colors duration-200">
          <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </span>
      </div>
    </div>

    <!-- Contraseña -->
    <div class="mb-4">
      <label for="password" class="block text-[13px] font-bold text-[#1a1a2e] mb-2">Contraseña</label>
      <div class="relative">
        <input type="password" id="password" placeholder="Mínimo 6 caracteres"
          autocomplete="new-password" required
          class="input-field w-full pl-11 pr-11 py-3.5 border-2 border-[#e8e0f5] rounded-[13px] text-[15px] font-semibold text-[#1a1a2e] bg-white placeholder:text-[#a0a0bb] placeholder:font-medium transition-all duration-200 outline-none" />
        <span class="input-icon absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a0a0bb] flex items-center pointer-events-none transition-colors duration-200">
          <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <button id="togglePwd1" type="button" aria-label="Mostrar contraseña"
          class="absolute right-3.5 top-1/2 -translate-y-1/2 bg-transparent border-none cursor-pointer text-[#a0a0bb] flex items-center p-1 transition-colors duration-200 hover:text-[#6C9BB5]">
          <svg id="eyeIcon1" class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
      <!-- Indicador de fortaleza -->
      <div class="strength-bar mt-2">
        <div id="strengthFill" class="strength-fill"></div>
      </div>
      <p id="strengthText" class="text-[11px] font-semibold mt-1 text-[#a0a0bb]"></p>
    </div>

    <!-- Confirmar contraseña -->
    <div class="mb-7">
      <label for="password2" class="block text-[13px] font-bold text-[#1a1a2e] mb-2">Confirmar contraseña</label>
      <div class="relative">
        <input type="password" id="password2" placeholder="Repite la contraseña"
          autocomplete="new-password" required
          class="input-field w-full pl-11 pr-11 py-3.5 border-2 border-[#e8e0f5] rounded-[13px] text-[15px] font-semibold text-[#1a1a2e] bg-white placeholder:text-[#a0a0bb] placeholder:font-medium transition-all duration-200 outline-none" />
        <span class="input-icon absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a0a0bb] flex items-center pointer-events-none transition-colors duration-200">
          <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <button id="togglePwd2" type="button" aria-label="Mostrar contraseña"
          class="absolute right-3.5 top-1/2 -translate-y-1/2 bg-transparent border-none cursor-pointer text-[#a0a0bb] flex items-center p-1 transition-colors duration-200 hover:text-[#6C9BB5]">
          <svg id="eyeIcon2" class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Submit -->
    <button id="registerBtn" type="button"
      class="w-full flex items-center justify-center gap-2 py-[15px] bg-[#6C9BB5] hover:bg-[#5a88a2] text-white rounded-[13px] text-base font-extrabold tracking-wide transition-all duration-200 hover:-translate-y-px active:translate-y-0 disabled:opacity-80 disabled:cursor-not-allowed mb-6 border-none cursor-pointer"
      style="box-shadow: 0 4px 20px rgba(108,155,181,0.35);">
      <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <line x1="19" y1="8" x2="19" y2="14"/>
        <line x1="22" y1="11" x2="16" y2="11"/>
      </svg>
      Crear cuenta
    </button>

    <!-- Login -->
    <p class="text-center text-sm font-semibold text-[#6b6b8a]">
      ¿Ya tienes cuenta?
      <a href="/login" class="text-[#6C9BB5] font-extrabold ml-1 no-underline transition-opacity hover:opacity-75">
        Inicia sesión
      </a>
    </p>

  </div>
</div>

<style>
  .input-field:focus {
    border-color: #6C9BB5;
    box-shadow: 0 0 0 4px rgba(108, 155, 181, 0.15);
  }
  .relative:focus-within .input-icon {
    color: #6C9BB5;
  }

  .strength-bar {
    height: 4px;
    background: #e8e0f5;
    border-radius: 99px;
    overflow: hidden;
  }
  .strength-fill {
    height: 100%;
    width: 0%;
    border-radius: 99px;
    transition: width 0.3s ease, background 0.3s ease;
  }

  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-6px); }
    40%     { transform: translateX(6px); }
    60%     { transform: translateX(-4px); }
    80%     { transform: translateX(4px); }
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  #errorMsg.visible   { display: flex; animation: shake 0.35s ease; }
  #successMsg.visible { display: flex; }
</style>

<script>
  const togglePwd1   = document.getElementById('togglePwd1') as HTMLButtonElement;
  const pwdInput1    = document.getElementById('password') as HTMLInputElement;
  const eyeIcon1     = document.getElementById('eyeIcon1') as unknown as SVGSVGElement;
  const togglePwd2   = document.getElementById('togglePwd2') as HTMLButtonElement;
  const pwdInput2    = document.getElementById('password2') as HTMLInputElement;
  const eyeIcon2     = document.getElementById('eyeIcon2') as unknown as SVGSVGElement;
  const registerBtn  = document.getElementById('registerBtn') as HTMLButtonElement;
  const errorMsg     = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText    = document.getElementById('errorText') as HTMLSpanElement;
  const successMsg   = document.getElementById('successMsg') as HTMLDivElement;
  const strengthFill = document.getElementById('strengthFill') as HTMLDivElement;
  const strengthText = document.getElementById('strengthText') as HTMLParagraphElement;

  const EYE_OPEN = `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
  const EYE_OFF  = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>`;

  togglePwd1.addEventListener('click', () => {
    const hidden = pwdInput1.type === 'password';
    pwdInput1.type = hidden ? 'text' : 'password';
    eyeIcon1.innerHTML = hidden ? EYE_OFF : EYE_OPEN;
  });
  togglePwd2.addEventListener('click', () => {
    const hidden = pwdInput2.type === 'password';
    pwdInput2.type = hidden ? 'text' : 'password';
    eyeIcon2.innerHTML = hidden ? EYE_OFF : EYE_OPEN;
  });

  pwdInput1.addEventListener('input', () => {
    const val = pwdInput1.value;
    let score = 0;
    if (val.length >= 6)          score++;
    if (val.length >= 10)         score++;
    if (/[A-Z]/.test(val))        score++;
    if (/[0-9]/.test(val))        score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { pct: '0%',   color: '#e8e0f5', label: '' },
      { pct: '25%',  color: '#f87171', label: 'Muy débil' },
      { pct: '50%',  color: '#fb923c', label: 'Débil' },
      { pct: '75%',  color: '#facc15', label: 'Aceptable' },
      { pct: '90%',  color: '#4ade80', label: 'Fuerte' },
      { pct: '100%', color: '#22c55e', label: 'Muy fuerte' },
    ];
    const lvl = levels[Math.min(score, 5)];
    strengthFill.style.width      = val.length ? lvl.pct : '0%';
    strengthFill.style.background = lvl.color;
    strengthText.textContent      = val.length ? lvl.label : '';
    strengthText.style.color      = lvl.color;
  });

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.classList.remove('hidden', 'visible');
    void errorMsg.offsetWidth;
    errorMsg.classList.add('visible');
  }
  function hideError() {
    errorMsg.classList.remove('visible');
    errorMsg.classList.add('hidden');
  }
  function setLoading(on: boolean) {
    registerBtn.disabled = on;
    registerBtn.innerHTML = on
      ? `<svg style="width:18px;height:18px;animation:spin .8s linear infinite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>Creando cuenta...`
      : `<svg style="width:18px;height:18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>Crear cuenta`;
  }

  async function handleRegister() {
    const nameEl  = document.getElementById('fullname') as HTMLInputElement;
    const emailEl = document.getElementById('email') as HTMLInputElement;
    const name  = nameEl.value.trim();
    const email = emailEl.value.trim();
    const pass  = pwdInput1.value;
    const pass2 = pwdInput2.value;

    hideError();

    if (!name)                                      { showError('Por favor, introduce tu nombre completo.'); nameEl.focus(); return; }
    if (!email)                                     { showError('Por favor, introduce tu correo electrónico.'); emailEl.focus(); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('El formato del correo no es válido.'); emailEl.focus(); return; }
    if (!pass)                                      { showError('Por favor, introduce una contraseña.'); pwdInput1.focus(); return; }
    if (pass.length < 6)                            { showError('La contraseña debe tener al menos 6 caracteres.'); pwdInput1.focus(); return; }
    if (pass !== pass2)                             { showError('Las contraseñas no coinciden.'); pwdInput2.focus(); return; }

    setLoading(true);

    try {
      const res  = await fetch('/api/registro', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password: pass })
      });
      const data = await res.json();
      if (!res.ok) { setLoading(false); showError(data.error ?? 'Error al crear la cuenta.'); return; }
      successMsg.classList.remove('hidden');
      successMsg.classList.add('visible');
      localStorage.setItem('token', data.token);
      setTimeout(() => { window.location.href = '/dashboard'; }, 1200);
    } catch {
      setLoading(false);
      showError('Error de conexión. Inténtalo de nuevo.');
    }
  }

  registerBtn.addEventListener('click', handleRegister);
  document.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') handleRegister(); });
</script>
