---
// src/components/auth/LoginForm.astro
---

<div class="flex items-center justify-center px-5 py-12 bg-[#faf8ff] md:px-10 lg:px-16 xl:px-20 lg:overflow-y-auto">
  <div class="w-full max-w-[400px] md:max-w-[440px] lg:max-w-[420px]">

    <h1 class="text-[24px] md:text-[28px] lg:text-[30px] xl:text-[32px] font-black text-[#1a1a2e] leading-tight mb-1">
      Bienvenid@ de nuevo
    </h1>
    <p class="text-sm md:text-[15px] font-medium text-[#6b6b8a] mb-7 leading-relaxed">
      Inicia sesión para ver el cuidado de tu familiar
    </p>

    <!-- Error banner -->
    <div
      id="errorMsg"
      role="alert"
      aria-live="polite"
      class="hidden items-center gap-2 bg-[#fff1f3] border-2 border-[#ffd0d8] rounded-xl px-4 py-3 mb-5 text-[13px] font-semibold text-[#e03b5a]"
    >
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span id="errorText">Email o contraseña incorrectos</span>
    </div>

    <!-- Email -->
    <div class="mb-5">
      <label for="email" class="block text-[13px] font-bold text-[#1a1a2e] mb-2">
        Correo electrónico
      </label>
      <div class="relative">
        <input
          type="email" id="email"
          placeholder="maria@ejemplo.com"
          autocomplete="email" required
          class="input-field w-full pl-11 pr-4 py-3.5 border-2 border-[#e8e0f5] rounded-[13px] text-[15px] font-semibold text-[#1a1a2e] bg-white placeholder:text-[#a0a0bb] placeholder:font-medium transition-all duration-200 outline-none"
        />
        <span class="input-icon absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a0a0bb] flex items-center pointer-events-none transition-colors duration-200">
          <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </span>
      </div>
    </div>

    <!-- Password -->
    <div class="mb-5">
      <label for="password" class="block text-[13px] font-bold text-[#1a1a2e] mb-2">
        Contraseña
      </label>
      <div class="relative">
        <input
          type="password" id="password"
          placeholder="••••••••"
          autocomplete="current-password" required
          class="input-field w-full pl-11 pr-11 py-3.5 border-2 border-[#e8e0f5] rounded-[13px] text-[15px] font-semibold text-[#1a1a2e] bg-white placeholder:text-[#a0a0bb] placeholder:font-medium transition-all duration-200 outline-none"
        />
        <span class="input-icon absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a0a0bb] flex items-center pointer-events-none transition-colors duration-200">
          <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <button
          id="togglePwd" type="button"
          aria-label="Mostrar contraseña"
          class="absolute right-3.5 top-1/2 -translate-y-1/2 bg-transparent border-none cursor-pointer text-[#a0a0bb] flex items-center p-1 transition-colors duration-200 hover:text-[#8000ff]"
        >
          <svg id="eyeIcon" class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Recordarme + Olvidaste -->
    <div class="flex items-center justify-between flex-wrap gap-2 mb-7">
      <!-- <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" id="remember" class="w-[17px] h-[17px] accent-[#8000ff] cursor-pointer" />
        <span class="text-[13px] font-semibold text-[#6C9BB5]">Recordarme</span>
      </label> -->
      <a href="#" class="text-[13px] font-bold text-[#6C9BB5] no-underline transition-opacity hover:opacity-70">
        ¿Olvidaste tu contraseña?
      </a>
    </div>

    <!-- Submit -->
    <button
      id="loginBtn" type="button"
      class="w-full flex items-center justify-center gap-2 py-[15px] bg-[#6C9BB5] hover:bg-[#9dbed1] text-white rounded-[13px] text-base font-extrabold tracking-wide transition-all duration-200 hover:-translate-y-px active:translate-y-0 disabled:opacity-80 disabled:cursor-not-allowed mb-6 border-none cursor-pointer"
      style="box-shadow: 0 4px 20px rgba(157,190,209,0.3);"
    >
      <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
        <polyline points="10 17 15 12 10 7"/>
        <line x1="15" y1="12" x2="3" y2="12"/>
      </svg>
      Iniciar sesión
    </button>

    <!-- Registro -->
    <p class="text-center text-sm font-semibold text-[#6b6b8a]">
      ¿No tienes cuenta aún?
      <a href="/registro" class="text-[#6C9BB5] font-extrabold ml-1 no-underline transition-opacity hover:opacity-75">
        Regístrate gratis
      </a>
    </p>

  </div>
</div>

<style>
  /* Focus ring y cambio de color del icono — no se puede hacer solo con Tailwind */
  .input-field:focus {
    border-color: #8000ff;
    box-shadow: 0 0 0 4px rgba(128, 0, 255, 0.1);
  }
  .relative:focus-within .input-icon {
    color: #8000ff;
  }

  /* Animaciones */
  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-6px); }
    40%     { transform: translateX(6px); }
    60%     { transform: translateX(-4px); }
    80%     { transform: translateX(4px); }
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  #errorMsg.visible {
    display: flex;
    animation: shake 0.35s ease;
  }
</style>

<script>
  const togglePwd = document.getElementById('togglePwd') as HTMLButtonElement;
  const pwdInput  = document.getElementById('password') as HTMLInputElement;
  const eyeIcon   = document.getElementById('eyeIcon') as SVGSVGElement;
  const loginBtn  = document.getElementById('loginBtn') as HTMLButtonElement;
  const errorMsg  = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText = document.getElementById('errorText') as HTMLSpanElement;

  const EYE_OPEN = `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
  const EYE_OFF  = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>`;

  togglePwd.addEventListener('click', () => {
    const hidden  = pwdInput.type === 'password';
    pwdInput.type = hidden ? 'text' : 'password';
    eyeIcon.innerHTML = hidden ? EYE_OFF : EYE_OPEN;
  });

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.classList.remove('visible');
    void errorMsg.offsetWidth;
    errorMsg.classList.add('visible');
  }

  function hideError() {
    errorMsg.classList.remove('visible');
    errorMsg.classList.add('hidden');
  }

  function setLoading(on: boolean) {
    loginBtn.disabled = on;
    loginBtn.innerHTML = on
      ? `<svg style="width:18px;height:18px;animation:spin .8s linear infinite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>Iniciando sesión...`
      : `<svg style="width:18px;height:18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>Iniciar sesión`;
  }

  async function handleLogin() {
    const emailEl = document.getElementById('email') as HTMLInputElement;
    const email   = emailEl.value.trim();
    const pass    = pwdInput.value;

    hideError();

    if (!email)                                     { showError('Por favor, introduce tu correo electrónico.'); emailEl.focus(); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('El formato del correo no es válido.');         emailEl.focus(); return; }
    if (!pass)                                      { showError('Por favor, introduce tu contraseña.');          pwdInput.focus(); return; }
    if (pass.length < 6)                            { showError('La contraseña debe tener al menos 6 caracteres.'); pwdInput.focus(); return; }

    setLoading(true);

    setTimeout(() => {
  setLoading(false);
  showError('Email o contraseña incorrectos. Inténtalo de nuevo.');
});

try {
  const res = await fetch('/api/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password: pass })
  })

  const data = await res.json()

  if (!res.ok) {
    setLoading(false)
    showError(data.error)
    return
  }

document.cookie = `token=${data.token}; path=/; max-age=604800; SameSite=Lax`;
  window.location.href = '/dashboard'

} catch (e) {
  setLoading(false)
  showError('Error de conexión. Inténtalo de nuevo.')
}

  }

  loginBtn.addEventListener('click', handleLogin);
  document.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') handleLogin(); });
</script>