---
import BottomNav from "../components/BottomNav.astro";
import '../styles/global.css';
import '../styles/calendario.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kinvia · Calendario</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
<main>

  <header class="page-header">
    <div class="bubble b1"></div>
    <div class="bubble b2"></div>
    <div class="header-inner">
      <div>
        <h1 class="header-title">Calendario</h1>
        <p class="header-sub" id="headerSub">Cargando...</p>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <button class="add-btn" id="addBtn" aria-label="Añadir evento">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <span class="add-btn-label">Añadir evento</span>
        </button>
        <button class="logout-btn" id="logoutBtn" aria-label="Cerrar sesión">
          <span class="logout-text">Cerrar sesión</span>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <path d="M16 17l5-5-5-5"/>
            <path d="M21 12H9"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <div class="filters-wrap">
    <div class="filters">
      <button class="filter-btn active" data-tipo="todos">Todos</button>
      <button class="filter-btn" data-tipo="cita"><span class="fdot" style="background:var(--color-cita)"></span>Citas</button>
      <button class="filter-btn" data-tipo="tarea"><span class="fdot" style="background:var(--color-tarea)"></span>Tareas</button>
      <button class="filter-btn" data-tipo="medicacion"><span class="fdot" style="background:var(--color-medicacion)"></span>Medicación</button>
      <button class="filter-btn" data-tipo="nota"><span class="fdot" style="background:var(--color-nota)"></span>Notas</button>
    </div>
  </div>

  <div class="cal-outer">
    <div class="cal-nav">
      <button class="nav-btn" id="prevMonth">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span class="cal-month-label" id="monthLabel">—</span>
      <button class="nav-btn" id="nextMonth">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
    <div class="cal-head">
      <div>LUN</div><div>MAR</div><div>MIÉ</div><div>JUE</div><div>VIE</div>
      <div class="wknd">SÁB</div><div class="wknd">DOM</div>
    </div>
    <div class="cal-grid" id="calGrid"></div>
  </div>

  <section class="all-events">
    <div class="all-events-header">
      <div>
        <h2 class="all-events-title">Todos los eventos</h2>
        <p class="all-events-sub" id="allEventsSub">Cargando...</p>
      </div>
      <span class="all-events-count" id="allEventsCount">0</span>
    </div>
    <div id="allEventsList" class="all-events-list">
      <div class="ae-loading">
        <svg width="18" height="18" style="animation:spin .9s linear infinite;color:var(--blue)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
        <span>Cargando eventos...</span>
      </div>
    </div>
  </section>

</main>

<BottomNav active="calendario" />

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitleLabel">Nuevo evento</h3>
      <button class="modal-close" id="modalClose">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="mfield">
        <label class="mlabel">Tipo</label>
        <div class="tipo-grid">
          <button class="tipo-btn active" data-tipo="cita">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Cita
          </button>
          <button class="tipo-btn" data-tipo="tarea">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            Tarea
          </button>
          <button class="tipo-btn" data-tipo="medicacion">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Medicación
          </button>
          <button class="tipo-btn" data-tipo="nota">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Nota
          </button>
        </div>
      </div>
      <div class="mfield">
        <label class="mlabel" for="mTitulo">Título *</label>
        <input type="text" id="mTitulo" class="minput" placeholder="Ej: Cita con el médico" />
      </div>
      <div class="mfield">
        <label class="mlabel" for="mDesc">Descripción</label>
        <input type="text" id="mDesc" class="minput" placeholder="Detalles adicionales..." />
      </div>
      <div class="mfield mfield-row">
        <div class="mhalf">
          <label class="mlabel" for="mFecha">Fecha *</label>
          <input type="date" id="mFecha" class="minput" />
        </div>
        <div class="mhalf">
          <label class="mlabel" for="mHora">Hora *</label>
          <input type="time" id="mHora" class="minput" />
        </div>
      </div>
      <p class="modal-error" id="modalError"></p>
      <button class="modal-submit" id="modalSubmit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
        Guardar evento
      </button>
    </div>
  </div>
</div>



<script>
  const MESES      = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const DIAS_LARGO = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
  const TIPO_COLOR = { cita:'#6C9BB5', tarea:'#a78bfa', medicacion:'#fb923c', nota:'#34d399' };
  const TIPO_BG    = { cita:'rgba(108,155,181,0.13)', tarea:'rgba(167,139,250,0.13)', medicacion:'rgba(251,146,60,0.13)', nota:'rgba(52,211,153,0.13)' };
  const TIPO_LABEL = { cita:'Cita médica', tarea:'Tarea', medicacion:'Medicación', nota:'Nota' };
  const TIPO_SVG   = {
    cita:       `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
    tarea:      `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
    medicacion: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`,
    nota:       `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`,
  };

  const AVATAR_COLORS = ['#6C9BB5','#5a88a2','#9dbed1','#4a7590','#a78bfa','#fb923c','#34d399'];
  function avatarColor(nombre) {
    let hash = 0;
    for (let i = 0; i < nombre.length; i++) hash = (hash * 31 + nombre.charCodeAt(i)) & 0xffffffff;
    return AVATAR_COLORS[Math.abs(hash) % AVATAR_COLORS.length];
  }
  function avatarInitials(nombre) {
    return nombre.split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();
  }

  let allEventos   = [];
  let filtroActivo = 'todos';
  let currentYear, currentMonth;

  function pad(n) { return String(n).padStart(2, '0'); }
  function toKey(y, m, d) { return `${y}-${pad(m + 1)}-${pad(d)}`; }
  function eventosFiltrados() { return filtroActivo === 'todos' ? allEventos : allEventos.filter(e => e.tipo === filtroActivo); }

  //Calendario
  function renderCalendar() {
    const grid  = document.getElementById('calGrid');
    const label = document.getElementById('monthLabel');
    document.getElementById('headerSub').textContent = `${MESES[currentMonth]} ${currentYear}`;
    label.textContent = `${MESES[currentMonth]} ${currentYear}`;

    const evs    = eventosFiltrados();
    const byDate = {};
    evs.forEach(e => { (byDate[e.fecha] = byDate[e.fecha] || []).push(e); });

    const firstDay    = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    const daysInPrev  = new Date(currentYear, currentMonth, 0).getDate();
    const startOffset = (firstDay + 6) % 7;
    const totalCells  = Math.ceil((startOffset + daysInMonth) / 7) * 7;
    const today       = new Date();
    const todayKey    = toKey(today.getFullYear(), today.getMonth(), today.getDate());

    const cells = [];
    for (let i = 0; i < totalCells; i++) {
      const isLastRow = i >= totalCells - 7;
      const col       = i % 7;
      const isWeekend = col === 5 || col === 6;
      if (i < startOffset) {
        const d  = daysInPrev - startOffset + i + 1;
        const pm = currentMonth - 1 < 0 ? 11 : currentMonth - 1;
        const py = currentMonth - 1 < 0 ? currentYear - 1 : currentYear;
        cells.push({ d, key: toKey(py, pm, d), cur: false, isLastRow, isWeekend });
      } else if (i < startOffset + daysInMonth) {
        const d = i - startOffset + 1;
        cells.push({ d, key: toKey(currentYear, currentMonth, d), cur: true, isLastRow, isWeekend });
      } else {
        const d  = i - startOffset - daysInMonth + 1;
        const nm = currentMonth + 1 > 11 ? 0 : currentMonth + 1;
        const ny = currentMonth + 1 > 11 ? currentYear + 1 : currentYear;
        cells.push({ d, key: toKey(ny, nm, d), cur: false, isLastRow, isWeekend });
      }
    }

    grid.innerHTML = cells.map(c => {
      const isToday = c.key === todayKey && c.cur;
      const dayEvs  = byDate[c.key] || [];
      let cls = 'cal-cell';
      if (!c.cur)               cls += ' other-month';
      if (isToday)              cls += ' today';
      if (c.isWeekend && c.cur) cls += ' weekend-cell';
      if (c.isLastRow)          cls += ' last-row';
      const evRows = dayEvs.slice(0, 2).map(e => `
        <div class="cell-ev" style="background:${TIPO_BG[e.tipo]};color:${TIPO_COLOR[e.tipo]}">
          <span class="cell-ev-dot" style="background:${TIPO_COLOR[e.tipo]}"></span>
          <span>${e.titulo}</span>
        </div>`).join('');
      const more = dayEvs.length > 2 ? `<div class="cell-more">+${dayEvs.length - 2} más</div>` : '';
      return `
        <div class="${cls}" data-date="${c.key}" data-cur="${c.cur}">
          <div class="cell-num">${c.d}</div>
          <div class="cell-events">${evRows}${more}</div>
        </div>`;
    }).join('');

  }

  // Todos los eventos
  function renderAllEvents() {
    const list  = document.getElementById('allEventsList');
    const sub   = document.getElementById('allEventsSub');
    const count = document.getElementById('allEventsCount');

    const evs = eventosFiltrados().slice().sort((a, b) => {
      const cmp = a.fecha.localeCompare(b.fecha);
      return cmp !== 0 ? cmp : a.hora.localeCompare(b.hora);
    });

    count.textContent = evs.length;
    sub.textContent = filtroActivo === 'todos'
      ? `${evs.length} evento${evs.length === 1 ? '' : 's'} en total`
      : `Filtrando: ${TIPO_LABEL[filtroActivo]}`;

    if (!evs.length) {
      list.innerHTML = `<div class="ae-empty"><div class="ae-empty-icon">🗓️</div><p>No hay eventos que mostrar</p></div>`;
      return;
    }

    const today    = new Date();
    const todayKey = toKey(today.getFullYear(), today.getMonth(), today.getDate());
    const grupos   = {};
    evs.forEach(e => { (grupos[e.fecha] = grupos[e.fecha] || []).push(e); });

    list.innerHTML = Object.keys(grupos).map(fecha => {
      const [y, m, d] = fecha.split('-').map(Number);
      const dateObj   = new Date(y, m - 1, d);
      const nombreDia = DIAS_LARGO[dateObj.getDay()];
      const esHoy     = fecha === todayKey;

      const cards = grupos[fecha].map((e, i) => {
        const creadorHTML = e.creado_por_nombre
          ? `<span class="ae-creador">
               <span class="ae-avatar" style="background:${avatarColor(e.creado_por_nombre)}">${avatarInitials(e.creado_por_nombre)}</span>
               <span class="ae-creador-nombre">${e.creado_por_nombre}</span>
             </span>`
          : '<span></span>';
        return `
          <div class="ae-card" data-id="${e.id}" style="animation-delay:${i * 0.05}s">
            <div class="ae-stripe" style="background:${TIPO_COLOR[e.tipo]}"></div>
            <div class="ae-card-inner">
              <div class="ae-icon-tipo" style="background:${TIPO_BG[e.tipo]};color:${TIPO_COLOR[e.tipo]}">
                ${TIPO_SVG[e.tipo]}
              </div>
              <div class="ae-body">
                <div class="ae-top">
                  <span class="ae-titulo">${e.titulo}</span>
                  <div class="ae-actions">
                    <span class="ae-hora">🕐 ${e.hora}</span>
                    <button class="btn-editar" data-id="${e.id}" title="Editar evento">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    </button>
                    <button class="btn-eliminar" data-id="${e.id}" title="Eliminar evento">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                    </button>
                  </div>
                </div>
                ${e.descripcion ? `<p class="ae-desc">${e.descripcion}</p>` : ''}
                <div class="ae-footer">
                  <span class="ae-chip" style="background:${TIPO_BG[e.tipo]};color:${TIPO_COLOR[e.tipo]}">${TIPO_LABEL[e.tipo]}</span>
                  ${creadorHTML}
                </div>
              </div>
            </div>
          </div>`;
      }).join('');

      return `
        <div class="ae-group">
          <div class="ae-group-date">
            ${nombreDia}, ${d} de ${MESES[m - 1]}
            ${esHoy ? '<span class="ae-today-badge">Hoy</span>' : ''}
          </div>
          ${cards}
        </div>`;
    }).join('');

    // Eventos de editar = que notas.astro
    list.querySelectorAll('.btn-editar').forEach(btn => {
      btn.addEventListener('click', () => {
        const ev = allEventos.find(e => String(e.id) === btn.dataset.id);
        if (!ev) return;
        // Rellenar modal editar
        document.getElementById('editar-id').value       = ev.id;
        document.getElementById('editar-titulo').value   = ev.titulo;
        document.getElementById('editar-desc').value     = ev.descripcion || '';
        document.getElementById('editar-fecha').value    = ev.fecha;
        document.getElementById('editar-hora').value     = ev.hora;
        document.getElementById('editar-tipo').value     = ev.tipo;
        document.getElementById('editar-error').classList.remove('visible');
        const modal = document.getElementById('modal-editar');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    // Eventos de eliminar = que notas.astro 
    list.querySelectorAll('.btn-eliminar').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Estás seguro de que quieres eliminar este evento?')) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/calendario/eliminar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: Number(btn.dataset.id) })
          });
          if (!res.ok) {
            const data = await res.json();
            throw new Error(data.error || 'Error al eliminar');
          }
          allEventos = allEventos.filter(e => String(e.id) !== btn.dataset.id);
          renderCalendar();
          renderAllEvents();
        } catch (error) {
          alert(error.message);
          btn.disabled = false;
        }
      });
    });
  }

  //Filtros
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filtroActivo = btn.dataset.tipo;
      renderCalendar();
      renderAllEvents();
    });
  });

  //Navegación mes a mes
    if (currentMonth === 0) { currentMonth = 11; currentYear--; } else currentMonth--;
    renderCalendar();
  });
  document.getElementById('nextMonth').addEventListener('click', () => {
    if (currentMonth === 11) { currentMonth = 0; currentYear++; } else currentMonth++;
    renderCalendar();
  });

  // Modal
  const overlay    = document.getElementById('modalOverlay');
  const modalClose = document.getElementById('modalClose');
  const submitBtn  = document.getElementById('modalSubmit');
  const modalError = document.getElementById('modalError');
  let tipoSel = 'cita';

  document.getElementById('addBtn').addEventListener('click', () => {
    const hoy = new Date();
    document.getElementById('mFecha').value = toKey(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
    document.getElementById('mTitulo').value = '';
    document.getElementById('mDesc').value   = '';
    document.getElementById('mHora').value   = '';
    document.querySelectorAll('.tipo-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('.tipo-btn[data-tipo="cita"]').classList.add('active');
    tipoSel = 'cita';
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  });
  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    modalError.textContent = '';
  }
  modalClose.addEventListener('click', closeModal);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });

  document.querySelectorAll('.tipo-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tipo-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      tipoSel = btn.dataset.tipo;
    });
  });

  submitBtn.addEventListener('click', async () => {
    const titulo = document.getElementById('mTitulo').value.trim();
    const desc   = document.getElementById('mDesc').value.trim();
    const fecha  = document.getElementById('mFecha').value;
    const hora   = document.getElementById('mHora').value;
    if (!titulo) { modalError.textContent = 'El título es obligatorio.'; return; }
    if (!fecha)  { modalError.textContent = 'La fecha es obligatoria.'; return; }
    if (!hora)   { modalError.textContent = 'La hora es obligatoria.'; return; }
    modalError.textContent = '';
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<svg width="16" height="16" style="animation:spin .8s linear infinite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>Guardando...`;
    try {
      const res = await fetch('/api/calendario/crear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: tipoSel, titulo, descripcion: desc, fecha, hora })
      });
      if (!res.ok) {
        let msg = 'Error al guardar el evento.';
        try { const err = await res.json(); if (err.error) msg = err.error; } catch {}
        modalError.textContent = msg;
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Guardar evento`;
        return;
      }
      const nuevo = await res.json();
      allEventos.push(nuevo);
    } catch {
      modalError.textContent = 'Error de conexión. Inténtalo de nuevo.';
      submitBtn.disabled = false;
      submitBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Guardar evento`;
      return;
    }
    closeModal();
    renderCalendar();
    renderAllEvents();
    submitBtn.disabled = false;
    submitBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Guardar evento`;
  });

  //Modal editar (=  notas.astro)
  document.getElementById('btn-cancelar-editar').addEventListener('click', () => {
    const modal = document.getElementById('modal-editar');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  });

  document.getElementById('form-editar').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id        = document.getElementById('editar-id').value;
    const tipo      = document.getElementById('editar-tipo').value;
    const titulo    = document.getElementById('editar-titulo').value.trim();
    const desc      = document.getElementById('editar-desc').value.trim();
    const fecha     = document.getElementById('editar-fecha').value;
    const hora      = document.getElementById('editar-hora').value;
    const errorEl   = document.getElementById('editar-error');
    const btnGuardar = document.getElementById('btn-guardar-editar');
    errorEl.classList.remove('visible');

    if (!titulo) { errorEl.textContent = 'El título no puede estar vacío.'; errorEl.classList.add('visible'); return; }
    if (!fecha)  { errorEl.textContent = 'La fecha es obligatoria.'; errorEl.classList.add('visible'); return; }
    if (!hora)   { errorEl.textContent = 'La hora es obligatoria.'; errorEl.classList.add('visible'); return; }

    btnGuardar.disabled = true;
    btnGuardar.textContent = 'Guardando...';

    try {
      const res = await fetch('/api/calendario/editar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id), tipo, titulo, descripcion: desc, fecha, hora })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error al editar');
      // Actualizar en local
      const idx = allEventos.findIndex(e => String(e.id) === String(id));
      if (idx !== -1) allEventos[idx] = { ...allEventos[idx], tipo, titulo, descripcion: desc, fecha, hora };
      document.getElementById('modal-editar').classList.add('hidden');
      document.getElementById('modal-editar').classList.remove('flex');
      renderCalendar();
      renderAllEvents();
    } catch (error) {
      errorEl.textContent = error.message;
      errorEl.classList.add('visible');
      btnGuardar.disabled = false;
      btnGuardar.textContent = 'Guardar';
    }
  });

  // ── Init: carga desde el backend ───────────────────────────────────────
  const now    = new Date();
  currentYear  = now.getFullYear();
  currentMonth = now.getMonth();

  async function cargarEventos() {
    try {
      const res = await fetch('/api/calendario/listar');
      if (res.ok) {
        const datos = await res.json();
        if (Array.isArray(datos)) allEventos = datos;
      } else {
        let msg = 'Error al cargar eventos.';
        try { const err = await res.json(); if (err.error) msg = err.error; } catch {}
        document.getElementById('allEventsList').innerHTML =
          `<div class="ae-empty"><div class="ae-empty-icon">⚠️</div><p>${msg}</p></div>`;
        document.getElementById('allEventsSub').textContent = '';
        renderCalendar();
        return;
      }
    } catch {
      document.getElementById('allEventsList').innerHTML =
        `<div class="ae-empty"><div class="ae-empty-icon">⚠️</div><p>Sin conexión con el servidor.</p></div>`;
      document.getElementById('allEventsSub').textContent = '';
      renderCalendar();
      return;
    }
    renderCalendar();
    renderAllEvents();
  }
  cargarEventos();

  document.getElementById('logoutBtn').addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/login';
  });
</script>

<!-- Modal editar evento — igual que notas.astro -->
<div id="modal-editar" class="modal-editar-overlay hidden">
  <div class="modal-editar-box">
    <h3>Editar evento</h3>
    <form id="form-editar">
      <input type="hidden" id="editar-id" />
      <select id="editar-tipo" class="modal-editar-select">
        <option value="cita">Cita médica</option>
        <option value="tarea">Tarea</option>
        <option value="medicacion">Medicación</option>
        <option value="nota">Nota</option>
      </select>
      <input type="text" id="editar-titulo" placeholder="Título" class="modal-editar-input" />
      <input type="text" id="editar-desc" placeholder="Descripción (opcional)" class="modal-editar-input" />
      <div style="display:flex;gap:10px;">
        <input type="date" id="editar-fecha" class="modal-editar-input" style="flex:1;margin-bottom:12px;" />
        <input type="time" id="editar-hora" class="modal-editar-input" style="flex:1;margin-bottom:12px;" />
      </div>
      <p id="editar-error" class="modal-editar-error"></p>
      <div class="modal-editar-btns">
        <button type="button" id="btn-cancelar-editar" class="modal-editar-cancel">Cancelar</button>
        <button type="submit" id="btn-guardar-editar" class="modal-editar-save">Guardar</button>
      </div>
    </form>
  </div>
</div>

</body>
</html>