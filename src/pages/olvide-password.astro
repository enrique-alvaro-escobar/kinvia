---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Recuperar contraseña">
  <div class="container">
    <h2>¿Olvidaste tu contraseña?</h2>
    <p>Introduce tu email y te enviaremos un enlace para recuperarla.</p>

    <input type="email" id="email" placeholder="tu@email.com" />
    <button id="btnSend">Enviar enlace</button>

    <p id="msg"></p>

    <p class="back-link">
      <a href="/login">← Volver al login</a>
    </p>
  </div>
</Layout>

<style>
  .container {
    max-width: 400px;
    margin: 80px auto;
    padding: 32px;
    font-family: sans-serif;
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }
  h2 { color: #1a1a2e; margin-bottom: 8px; }
  p { color: #666; margin-bottom: 20px; }
  input {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 2px solid #e8e0f5;
    border-radius: 12px;
    font-size: 15px;
    box-sizing: border-box;
  }
  input:focus {
    outline: none;
    border-color: #6C9BB5;
  }
  button {
    width: 100%;
    padding: 12px;
    background: #6C9BB5;
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: bold;
    font-size: 15px;
    cursor: pointer;
    margin-top: 8px;
  }
  button:hover { background: #5a88a2; }
  button:disabled { opacity: 0.6; cursor: not-allowed; }
  #msg { margin-top: 12px; font-size: 14px; }
  .back-link {
    text-align: center;
    margin-top: 24px;
    margin-bottom: 0;
  }
  .back-link a { color: #6C9BB5; text-decoration: none; }
</style>

<script>
  const btn = document.getElementById('btnSend') as HTMLButtonElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const msg = document.getElementById('msg') as HTMLParagraphElement;

  btn.addEventListener('click', async () => {
    const email = emailInput.value.trim();

    if (!email) {
      msg.textContent = 'Introduce tu email.';
      msg.style.color = 'red';
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      msg.textContent = 'Email no válido.';
      msg.style.color = 'red';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    msg.textContent = '';

    try {
      const res = await fetch('/api/olvide-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      if (res.ok) {
        msg.textContent = '✓ Si el email existe, recibirás un enlace en tu bandeja.';
        msg.style.color = 'green';
        emailInput.value = '';
      } else {
        msg.textContent = 'Error. Inténtalo de nuevo.';
        msg.style.color = 'red';
      }
    } catch {
      msg.textContent = 'Error de conexión.';
      msg.style.color = 'red';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar enlace';
    }
  });

  emailInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') btn.click();
  });
</script>