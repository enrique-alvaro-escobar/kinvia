---
import Layout from "../layouts/Layout.astro";
import { query } from "../lib/db.js";
import crypto from 'crypto';

// Leer el token de la URL
const token = Astro.url.searchParams.get('token');
let tokenValido = false;

if (token) {
  // Hashear el token recibido y buscarlo en DB
  const tokenHash = crypto.createHash('sha256').update(token).digest('hex');
  const result = await query(
    `SELECT id FROM password_resets
     WHERE token_hash = $1
       AND usado = FALSE
       AND expira_en > NOW()`,
    [tokenHash]
  );
  tokenValido = result.rows.length > 0;
}
---

<Layout title="Nueva contraseña">
  <div class="container">
    {!tokenValido ? (
      <div>
        <h2>Enlace inválido o expirado</h2>
        <p>Este enlace ha caducado, ya fue usado, o no es válido.</p>
        <p>
          <a href="/olvide-password" class="primary-link">Solicitar uno nuevo</a>
        </p>
      </div>
    ) : (
      <div>
        <h2>Nueva contraseña</h2>
        <p>Elige una contraseña segura para tu cuenta.</p>

        <input type="password" id="pwd1" placeholder="Nueva contraseña (mín. 6)" />
        <input type="password" id="pwd2" placeholder="Repite la contraseña" />
        <button id="btnReset">Guardar nueva contraseña</button>

        <p id="msg"></p>
      </div>
    )}
  </div>
</Layout>

<style>
  .container {
    max-width: 400px;
    margin: 80px auto;
    padding: 32px;
    font-family: sans-serif;
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }
  h2 { color: #1a1a2e; margin-bottom: 8px; }
  p { color: #666; margin-bottom: 20px; }
  input {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 2px solid #e8e0f5;
    border-radius: 12px;
    font-size: 15px;
    box-sizing: border-box;
  }
  input:focus { outline: none; border-color: #6C9BB5; }
  button {
    width: 100%;
    padding: 12px;
    background: #6C9BB5;
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: bold;
    font-size: 15px;
    cursor: pointer;
    margin-top: 8px;
  }
  button:hover { background: #5a88a2; }
  button:disabled { opacity: 0.6; cursor: not-allowed; }
  #msg { margin-top: 12px; font-size: 14px; }
  .primary-link {
    color: #6C9BB5;
    font-weight: bold;
    text-decoration: none;
  }
</style>

<script define:vars={{ token }}>
  const btn = document.getElementById('btnReset');

  if (btn) {
    btn.addEventListener('click', async () => {
      const p1 = document.getElementById('pwd1').value;
      const p2 = document.getElementById('pwd2').value;
      const msg = document.getElementById('msg');

      if (p1.length < 6) {
        msg.textContent = 'La contraseña debe tener al menos 6 caracteres.';
        msg.style.color = 'red';
        return;
      }
      if (p1 !== p2) {
        msg.textContent = 'Las contraseñas no coinciden.';
        msg.style.color = 'red';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Guardando...';

      try {
        const res = await fetch('/api/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password: p1 })
        });
        const data = await res.json();

        if (res.ok) {
          msg.textContent = '✓ ¡Contraseña actualizada! Redirigiendo...';
          msg.style.color = 'green';
          setTimeout(() => window.location.href = '/login', 1500);
        } else {
          msg.textContent = data.error || 'Error al guardar.';
          msg.style.color = 'red';
          btn.disabled = false;
          btn.textContent = 'Guardar nueva contraseña';
        }
      } catch {
        msg.textContent = 'Error de conexión.';
        msg.style.color = 'red';
        btn.disabled = false;
        btn.textContent = 'Guardar nueva contraseña';
      }
    });
  }
</script>