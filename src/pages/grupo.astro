---
// src/pages/grupo.astro
import BottomNav from "../components/BottomNav.astro";
import '../styles/global.css';

// En producción reemplaza con fetch a tus API routes
const grupo = {
  nombre: "Familia González",
  cuidado: "Abuela Rosa",
  codigo: "FAMILIA-GONZALEZ-2026",
};

const miembros = [
  { initial: "M", bg: "#6C9BB5", nombre: "María González",  email: "maria@example.com",  rol: "Admin", eres_tu: true },
  { initial: "J", bg: "#5a88a2", nombre: "Juan Pérez",      email: "juan@example.com",   rol: null,    eres_tu: false },
  { initial: "A", bg: "#9dbed1", nombre: "Ana Martínez",    email: "ana@example.com",    rol: null,    eres_tu: false },
  { initial: "C", bg: "#4a7590", nombre: "Carlos Sánchez",  email: "carlos@example.com", rol: null,    eres_tu: false },
];

const actividad = [
  { valor: 24, label: "Tareas completadas", color: "#6C9BB5",  bg: "#eef4f8" },
  { valor: 18, label: "Eventos este mes",   color: "#4ade80",  bg: "#f0fdf4" },
  { valor: 12, label: "Notas compartidas",  color: "#a78bfa",  bg: "#f5f3ff" },
  { valor: 45, label: "Días activos",       color: "#fb923c",  bg: "#fff7ed" },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kinvia · Grupo familiar</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --blue:        #6C9BB5;
      --blue-dark:   #5a88a2;
      --blue-darker: #4a7590;
      --blue-light:  #9dbed1;
      --blue-bg:     #eef4f8;
      --blue-bg-soft:#f4f8fb;
      --text-primary:   #1a1a2e;
      --text-secondary: #6b6b8a;
      --text-muted:     #a0a0bb;
      --bg:    #faf8ff;
      --white: #ffffff;
      --border: #e8e0f5;
      --radius: 16px;
      --shadow: 0 2px 16px rgba(108,155,181,0.10);
    }
    html, body {
      height: 100%;
      font-family: 'Nunito', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      -webkit-font-smoothing: antialiased;
    }
    body { display: flex; flex-direction: column; min-height: 100dvh; }
    main { flex: 1; overflow-y: auto; padding-bottom: 90px; }
  </style>
</head>
<body>
<main>

  <!-- ══════════════ HEADER ══════════════ -->
  <header class="page-header">
    <div class="bubble b1"></div>
    <div class="bubble b2"></div>
    <div class="bubble b3"></div>
    <div class="header-inner">
      <div>
        <h1 class="header-title">Grupo Familiar</h1>
        <p class="header-sub">{grupo.nombre}</p>
      </div>
    </div>
  </header>

  <!-- ══════════════ CONTENT ══════════════ -->
  <div class="content">

    <!-- Info del grupo -->
    <section class="card" style="animation-delay:0.03s">
      <div class="group-info">
        <div class="group-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <p class="group-name">{grupo.nombre}</p>
          <p class="group-care">Cuidando de {grupo.cuidado}</p>
        </div>
      </div>

      <div class="divider"></div>

      <!-- Código de invitación -->
      <div class="invite-row">
        <div>
          <p class="invite-label">Código de invitación</p>
          <p class="invite-code" id="inviteCode">{grupo.codigo}</p>
        </div>
        <button class="copy-btn" id="copyBtn" aria-label="Copiar código">
          <svg id="copyIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
      </div>

      <div class="divider"></div>

      <!-- Botón invitar -->
      <button class="invite-btn" id="inviteBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <line x1="19" y1="8" x2="19" y2="14"/>
          <line x1="22" y1="11" x2="16" y2="11"/>
        </svg>
        Invitar miembro
      </button>
    </section>

    <!-- Miembros -->
    <section class="card" style="animation-delay:0.07s">
      <div class="card-header">
        <h2 class="card-title">Miembros ({miembros.length})</h2>
      </div>
      <div class="card-body members-list">
        {miembros.map(m => (
          <div class="member-row">
            <div class="member-avatar" style={`background:${m.bg}`}>{m.initial}</div>
            <div class="member-info">
              <div class="member-name-row">
                <span class="member-name">{m.nombre}</span>
                {m.eres_tu && <span class="badge-tu">Tú</span>}
                {m.eres_tu && (
                  <span class="badge-crown">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  </span>
                )}
              </div>
              <span class="member-email">{m.email}</span>
            </div>
            {m.rol && <span class="badge-rol">{m.rol}</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- Actividad del grupo -->
    <section class="card" style="animation-delay:0.11s">
      <div class="card-header">
        <h2 class="card-title">Actividad del grupo</h2>
      </div>
      <div class="card-body">
        <div class="activity-grid">
          {actividad.map(a => (
            <div class="activity-cell" style={`background:${a.bg}`}>
              <span class="activity-val" style={`color:${a.color}`}>{a.valor}</span>
              <span class="activity-label">{a.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Configuración -->
    <section class="card" style="animation-delay:0.15s">
      <div class="card-header">
        <h2 class="card-title">Configuración</h2>
      </div>
      <div class="card-body config-list">
        <a href="/ajustes/notificaciones" class="config-row">
          <div class="config-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
            </svg>
          </div>
          <span class="config-label">Ajustes de notificaciones</span>
          <svg class="config-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>

        <div class="config-divider"></div>

        <button class="config-row config-logout" id="logoutBtn">
          <div class="config-icon logout-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </div>
          <span class="config-label logout-label">Cerrar sesión</span>
        </button>
      </div>
    </section>

  </div>
</main>

<BottomNav active="grupo" />

<!-- Toast de copiado -->
<div id="toast" class="toast">¡Código copiado!</div>

<style>
  /* HEADER */
  .page-header {
    position: relative;
    background: #6C9BB5;
    padding: 32px 24px 36px;
    overflow: hidden;
  }
  .bubble { position: absolute; border-radius: 50%; pointer-events: none; }
  .b1 { width: 360px; height: 360px; background: rgba(255,255,255,0.06); top: -120px; right: -90px; }
  .b2 { width: 240px; height: 240px; background: rgba(255,255,255,0.05); bottom: -70px; left: -60px; }
  .b3 { width: 150px; height: 150px; background: rgba(255,255,255,0.04); top: 50%; left: 30%; transform: translate(-50%,-50%); }

  .header-inner {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
  }
  .header-title { font-size: 1.45rem; font-weight: 900; color: #fff; line-height: 1.2; }
  .header-sub   { font-size: 0.88rem; color: rgba(255,255,255,0.75); font-weight: 600; margin-top: 2px; }

  /* CONTENT */
  .content { padding: 20px; display: flex; flex-direction: column; gap: 16px; }

  /* CARDS */
  .card {
    background: var(--white);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
    animation: fadeUp 0.35s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .card-header { padding: 20px 22px 0; }
  .card-title  { font-size: 1.05rem; font-weight: 900; color: var(--text-primary); }
  .card-body   { padding: 10px 22px 18px; }

  /* GROUP INFO */
  .group-info {
    display: flex; align-items: center; gap: 14px;
    padding: 20px 22px 16px;
  }
  .group-avatar {
    width: 48px; height: 48px; border-radius: 14px;
    background: var(--blue-bg); color: var(--blue);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .group-avatar svg { width: 24px; height: 24px; }
  .group-name { font-size: 1rem; font-weight: 900; color: var(--text-primary); }
  .group-care { font-size: 0.80rem; color: var(--text-secondary); font-weight: 600; margin-top: 2px; }

  .divider { height: 1px; background: var(--border); margin: 0 22px; }

  /* INVITE */
  .invite-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 22px;
  }
  .invite-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-bottom: 3px; }
  .invite-code  { font-size: 0.88rem; font-weight: 800; color: var(--text-primary); letter-spacing: 0.02em; }

  .copy-btn {
    width: 36px; height: 36px;
    background: var(--blue-bg); border: 1px solid #c8dfe9;
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--blue); transition: all 0.2s; flex-shrink: 0;
  }
  .copy-btn:hover { background: var(--blue); color: white; }
  .copy-btn svg { width: 16px; height: 16px; }

  .invite-btn {
    width: calc(100% - 44px); margin: 0 22px 18px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 14px; background: var(--text-primary); color: white;
    border: none; border-radius: 13px;
    font-family: 'Nunito', sans-serif; font-size: 0.95rem; font-weight: 800;
    cursor: pointer; transition: all 0.2s; letter-spacing: 0.01em;
  }
  .invite-btn:hover { background: #2d2d4a; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(26,26,46,0.2); }
  .invite-btn svg { width: 18px; height: 18px; }

  /* MEMBERS */
  .members-list { display: flex; flex-direction: column; gap: 2px; }
  .member-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0; border-bottom: 1px solid var(--border);
  }
  .member-row:last-child { border-bottom: none; }

  .member-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.88rem; font-weight: 900; color: white;
    flex-shrink: 0; border: 2px solid var(--white);
    box-shadow: 0 2px 8px rgba(108,155,181,0.22);
  }
  .member-info  { flex: 1; min-width: 0; }
  .member-name-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .member-name  { font-size: 0.92rem; font-weight: 800; color: var(--text-primary); }
  .member-email { font-size: 0.76rem; color: var(--text-muted); font-weight: 600; }

  .badge-tu {
    font-size: 0.62rem; font-weight: 800; padding: 2px 7px;
    background: var(--blue-bg); color: var(--blue-darker);
    border: 1px solid #c8dfe9; border-radius: 99px; letter-spacing: 0.03em;
  }
  .badge-crown {
    color: #f59e0b; display: flex; align-items: center;
  }
  .badge-crown svg { width: 14px; height: 14px; fill: #fbbf24; stroke: #f59e0b; }

  .badge-rol {
    font-size: 0.70rem; font-weight: 800; padding: 4px 12px;
    background: var(--blue-bg); color: var(--blue-darker);
    border: 1px solid #c8dfe9; border-radius: 99px;
    white-space: nowrap; flex-shrink: 0;
  }

  /* ACTIVITY */
  .activity-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; margin-top: 4px;
  }
  .activity-cell {
    border-radius: 12px; padding: 16px 14px;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
  }
  .activity-val   { font-size: 1.8rem; font-weight: 900; line-height: 1; }
  .activity-label { font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); text-align: center; }

  /* CONFIG */
  .config-list { display: flex; flex-direction: column; }
  .config-row {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 0; text-decoration: none; cursor: pointer;
    background: none; border: none; width: 100%;
    font-family: 'Nunito', sans-serif;
    transition: opacity 0.15s;
  }
  .config-row:hover { opacity: 0.75; }

  .config-icon {
    width: 34px; height: 34px; border-radius: 10px;
    background: var(--blue-bg); color: var(--blue);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .config-icon svg { width: 17px; height: 17px; }

  .logout-icon { background: #fff1f3; color: #e03b5a; }

  .config-label {
    flex: 1; font-size: 0.92rem; font-weight: 700; color: var(--text-primary);
    text-align: left;
  }
  .logout-label { color: #e03b5a; }

  .config-arrow { width: 16px; height: 16px; color: var(--text-muted); flex-shrink: 0; }
  .config-divider { height: 1px; background: var(--border); }

  /* TOAST */
  .toast {
    position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%) translateY(20px);
    background: var(--text-primary); color: white;
    font-family: 'Nunito', sans-serif; font-size: 0.82rem; font-weight: 700;
    padding: 10px 20px; border-radius: 99px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    white-space: nowrap; z-index: 200;
  }
  .toast.show {
    opacity: 1; transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  // Copiar código de invitación
  const copyBtn   = document.getElementById('copyBtn') as HTMLButtonElement;
  const copyIcon  = document.getElementById('copyIcon') as unknown as SVGSVGElement;
  const invCode   = document.getElementById('inviteCode') as HTMLParagraphElement;
  const toast     = document.getElementById('toast') as HTMLDivElement;
  const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(invCode.textContent ?? '');
    } catch {
      // fallback para navegadores sin permisos
      const ta = document.createElement('textarea');
      ta.value = invCode.textContent ?? '';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    // Check icon temporal
    copyIcon.innerHTML = `<polyline points="20 6 9 17 4 12"/>`;
    copyBtn.style.background = '#6C9BB5';
    copyBtn.style.color = 'white';
    // Toast
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
      copyIcon.innerHTML = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>`;
      copyBtn.style.background = '';
      copyBtn.style.color = '';
    }, 2000);
  });

  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem('token');
    window.location.href = '/login';
  });
</script>

</body>
</html>
