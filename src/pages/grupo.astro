---
import BottomNav from "../components/BottomNav.astro";
import '../styles/global.css';
import { query } from "../lib/db.js";

// ── Leer token de la cookie ─────────────────────────────────────
const token = Astro.cookies.get("token")?.value;
if (!token) return Astro.redirect("/login");

let grupo = { nombre: "Mi familia", cuidado: "", codigo: "" };
let miembros = [];
let actividad = [
  { valor: 0, label: "Tareas completadas", color: "#6C9BB5", bg: "#eef4f8" },
  { valor: 0, label: "Eventos este mes",   color: "#4ade80", bg: "#f0fdf4" },
  { valor: 0, label: "Notas compartidas",  color: "#a78bfa", bg: "#f5f3ff" },
  { valor: 0, label: "Días activos",       color: "#fb923c", bg: "#fff7ed" },
];

let tieneGrupo = false;

try {
  const payload = JSON.parse(Buffer.from(token, "base64").toString());
  const grupo_id = payload.grupo_id;
  const usuario_id = payload.id;

  tieneGrupo = !!grupo_id;

  if (grupo_id) {
    // Datos del grupo
    const grupoRes = await query('SELECT * FROM grupos WHERE id = $1', [grupo_id]);
    if (grupoRes.rows.length > 0) {
      grupo = {
        nombre: grupoRes.rows[0].nombre,
        cuidado: "",
        codigo: `KINVIA-${grupoRes.rows[0].id}-${grupoRes.rows[0].nombre.replace(/\s+/g, '').toUpperCase()}`
      };
    }

    // Miembros del grupo
    const miembrosRes = await query(
      `SELECT u.id, u.nombre, u.email, ug.rol
       FROM usuarios u
       INNER JOIN usuarios_grupos ug ON u.id = ug.usuario_id
       WHERE ug.grupo_id = $1
       ORDER BY ug.rol DESC`,
      [grupo_id]
    );
    const colores = ["#6C9BB5", "#5a88a2", "#9dbed1", "#4a7590"];
    miembros = miembrosRes.rows.map((m, i) => ({
      initial: m.nombre.split(" ").map((n) => n[0]).slice(0, 2).join("").toUpperCase(),
      bg: colores[i % colores.length],
      nombre: m.nombre,
      email: m.email,
      rol: m.rol === 'admin' ? 'Admin' : null,
      eres_tu: m.id === usuario_id
    }));

    // Actividad real
    const tareasComp = await query(
      `SELECT COUNT(*) FROM tareas WHERE grupo_id = $1 AND estado = 'completada'`,
      [grupo_id]
    );
    const eventosMes = await query(
      `SELECT COUNT(*) FROM eventos WHERE grupo_id = $1 AND DATE_TRUNC('month', fecha_hora) = DATE_TRUNC('month', NOW())`,
      [grupo_id]
    );
    const notasTotal = await query(
      `SELECT COUNT(*) FROM notas WHERE grupo_id = $1`,
      [grupo_id]
    );
    const diasActivos = await query(
      `SELECT COUNT(DISTINCT DATE(created_at)) FROM tareas WHERE grupo_id = $1`,
      [grupo_id]
    );

    actividad = [
      { valor: parseInt(tareasComp.rows[0].count),  label: "Tareas completadas", color: "#6C9BB5", bg: "#eef4f8" },
      { valor: parseInt(eventosMes.rows[0].count),  label: "Eventos este mes",   color: "#4ade80", bg: "#f0fdf4" },
      { valor: parseInt(notasTotal.rows[0].count),  label: "Notas compartidas",  color: "#a78bfa", bg: "#f5f3ff" },
      { valor: parseInt(diasActivos.rows[0].count), label: "Días activos",       color: "#fb923c", bg: "#fff7ed" },
    ];
  }

} catch (e) {
  console.error("Error en grupo.astro:", e);
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kinvia · Grupo familiar</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --blue:        #6C9BB5;
      --blue-dark:   #5a88a2;
      --blue-darker: #4a7590;
      --blue-light:  #9dbed1;
      --blue-bg:     #eef4f8;
      --blue-bg-soft:#f4f8fb;
      --text-primary:   #1a1a2e;
      --text-secondary: #6b6b8a;
      --text-muted:     #a0a0bb;
      --bg:    #faf8ff;
      --white: #ffffff;
      --border: #e8e0f5;
      --radius: 16px;
      --shadow: 0 2px 16px rgba(108,155,181,0.10);
    }
    html, body {
      height: 100%;
      font-family: 'Nunito', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      -webkit-font-smoothing: antialiased;
    }
    body { display: flex; flex-direction: column; min-height: 100dvh; }
    main { flex: 1; overflow-y: auto; padding-bottom: 90px; }
  </style>
</head>
<body>
<main>

  <!-- ══════════════ HEADER ══════════════ -->
  <header class="page-header">
    <div class="bubble b1"></div>
    <div class="bubble b2"></div>
    <div class="bubble b3"></div>
    <div class="header-inner">
      <div>
        <h1 class="header-title">Grupo Familiar</h1>
        <p class="header-sub">{tieneGrupo ? grupo.nombre : "Sin grupo asignado"}</p>
      </div>
    </div>
  </header>

  <!-- ══════════════ CONTENT ══════════════ -->
  <div class="content">

    {tieneGrupo ? (
      <>
        <!-- Info del grupo -->
        <section class="card" style="animation-delay:0.03s">
          <div class="group-info">
            <div class="group-avatar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div>
              <p class="group-name">{grupo.nombre}</p>
              <p class="group-care">{grupo.cuidado ? `Cuidando de ${grupo.cuidado}` : "Grupo familiar"}</p>
            </div>
          </div>

          <div class="divider"></div>

          <!-- Código de invitación -->
          <div class="invite-row">
            <div>
              <p class="invite-label">Código de invitación</p>
              <p class="invite-code" id="inviteCode">{grupo.codigo}</p>
            </div>
            <button class="copy-btn" id="copyBtn" aria-label="Copiar código">
              <svg id="copyIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
            </button>
          </div>

          <div class="divider"></div>

          <!-- Botón invitar -->
          <button class="invite-btn" id="inviteBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
            Invitar miembro
          </button>
        </section>

        <!-- Miembros -->
        <section class="card" style="animation-delay:0.07s">
          <div class="card-header">
            <h2 class="card-title">Miembros ({miembros.length})</h2>
          </div>
          <div class="card-body members-list">
            {miembros.map(m => (
              <div class="member-row">
                <div class="member-avatar" style={`background:${m.bg}`}>{m.initial}</div>
                <div class="member-info">
                  <div class="member-name-row">
                    <span class="member-name">{m.nombre}</span>
                    {m.eres_tu && <span class="badge-tu">Tú</span>}
                    {m.eres_tu && (
                      <span class="badge-crown">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                      </span>
                    )}
                  </div>
                  <span class="member-email">{m.email}</span>
                </div>
                {m.rol && <span class="badge-rol">{m.rol}</span>}
              </div>
            ))}
          </div>
        </section>
      </>
    ) : (
      /* ════════ SIN GRUPO: crear o unirse ════════ */
      <>
        <!-- Crear grupo -->
        <section class="card" style="animation-delay:0.03s">
          <div class="card-header">
            <h2 class="card-title">Crear un grupo familiar</h2>
          </div>
          <div class="card-body">
            <p class="section-desc">Crea tu propio grupo e invita a tu familia. Serás el administrador.</p>
            <div class="form-field">
              <label class="form-label" for="nombreGrupo">Nombre del grupo</label>
              <input
                id="nombreGrupo"
                type="text"
                class="form-input"
                placeholder="Ej: Familia García"
                maxlength="60"
              />
            </div>
            <div id="crearError" class="form-error" style="display:none"></div>
            <button class="action-btn btn-dark" id="crearBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="16"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
              </svg>
              Crear grupo
            </button>
          </div>
        </section>

        <!-- Separador -->
        <div class="or-divider">
          <span class="or-line"></span>
          <span class="or-text">o</span>
          <span class="or-line"></span>
        </div>

        <!-- Unirse a un grupo -->
        <section class="card" style="animation-delay:0.07s">
          <div class="card-header">
            <h2 class="card-title">Unirse a un grupo</h2>
          </div>
          <div class="card-body">
            <p class="section-desc">Introduce el código que te compartió un miembro de tu familia.</p>
            <div class="form-field">
              <label class="form-label" for="codigoGrupo">Código de invitación</label>
              <input
                id="codigoGrupo"
                type="text"
                class="form-input"
                placeholder="Ej: KINVIA-12-FAMILIAGARCIA"
                autocapitalize="characters"
              />
            </div>
            <div id="unirseError" class="form-error" style="display:none"></div>
            <button class="action-btn btn-blue" id="unirseBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <polyline points="10 17 15 12 10 7"/>
                <line x1="15" y1="12" x2="3" y2="12"/>
              </svg>
              Unirse al grupo
            </button>
          </div>
        </section>
      </>
    )}

    <!-- Configuración (siempre visible) -->
    <section class="card" style="animation-delay:0.15s">
      <div class="card-header">
        <h2 class="card-title">Configuración</h2>
      </div>
      <div class="card-body config-list">
        <a href="/ajustes/notificaciones" class="config-row">
          <div class="config-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
            </svg>
          </div>
          <span class="config-label">Ajustes de notificaciones</span>
          <svg class="config-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>

        <div class="config-divider"></div>

        <button class="config-row config-logout" id="logoutBtn">
          <div class="config-icon logout-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </div>
          <span class="config-label logout-label">Cerrar sesión</span>
        </button>
      </div>
    </section>

  </div>
</main>

<BottomNav active="grupo" />

<!-- Toast -->
<div id="toast" class="toast"></div>

<!-- Modal de invitar (visible solo cuando tiene grupo) -->
{tieneGrupo && (
  <div id="inviteModal" class="modal-overlay" style="display:none">
    <div class="modal-box">
      <div class="modal-header">
        <h3 class="modal-title">Invitar miembro</h3>
        <button class="modal-close" id="modalClose" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <p class="modal-desc">Comparte este código con quien quieras invitar a tu grupo:</p>
      <div class="modal-code-box">
        <span id="modalCode">{grupo.codigo}</span>
        <button class="modal-copy" id="modalCopyBtn" aria-label="Copiar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
)}

<style>
  /* HEADER */
  .page-header {
    position: relative; background: #6C9BB5;
    padding: 32px 24px 36px; overflow: hidden;
  }
  .bubble { position: absolute; border-radius: 50%; pointer-events: none; }
  .b1 { width: 360px; height: 360px; background: rgba(255,255,255,0.06); top: -120px; right: -90px; }
  .b2 { width: 240px; height: 240px; background: rgba(255,255,255,0.05); bottom: -70px; left: -60px; }
  .b3 { width: 150px; height: 150px; background: rgba(255,255,255,0.04); top: 50%; left: 30%; transform: translate(-50%,-50%); }

  .header-inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
  .header-title { font-size: 1.45rem; font-weight: 900; color: #fff; line-height: 1.2; }
  .header-sub   { font-size: 0.88rem; color: rgba(255,255,255,0.75); font-weight: 600; margin-top: 2px; }

  /* CONTENT */
  .content { padding: 20px; display: flex; flex-direction: column; gap: 16px; }

  /* CARDS */
  .card {
    background: var(--white); border-radius: var(--radius);
    border: 1px solid var(--border); box-shadow: var(--shadow);
    overflow: hidden; animation: fadeUp 0.35s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .card-header { padding: 20px 22px 0; }
  .card-title  { font-size: 1.05rem; font-weight: 900; color: var(--text-primary); }
  .card-body   { padding: 10px 22px 18px; }

  /* SECTION DESC */
  .section-desc {
    font-size: 0.82rem; color: var(--text-secondary); font-weight: 600;
    margin-bottom: 14px; line-height: 1.5;
  }

  /* FORM */
  .form-field { margin-bottom: 12px; }
  .form-label {
    display: block; font-size: 0.75rem; font-weight: 800;
    color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.03em;
  }
  .form-input {
    width: 100%; padding: 12px 14px;
    border: 1.5px solid var(--border); border-radius: 11px;
    font-family: 'Nunito', sans-serif; font-size: 0.92rem; font-weight: 700;
    color: var(--text-primary); background: var(--white);
    transition: border-color 0.2s, box-shadow 0.2s; outline: none;
  }
  .form-input:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(108,155,181,0.15);
  }
  .form-error {
    font-size: 0.78rem; font-weight: 700; color: #e03b5a;
    background: #fff1f3; border-radius: 8px; padding: 8px 12px;
    margin-bottom: 10px;
  }

  /* ACTION BUTTONS */
  .action-btn {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 14px; border: none; border-radius: 13px;
    font-family: 'Nunito', sans-serif; font-size: 0.95rem; font-weight: 800;
    cursor: pointer; transition: all 0.2s; letter-spacing: 0.01em;
  }
  .action-btn svg { width: 18px; height: 18px; }
  .btn-dark  { background: var(--text-primary); color: white; }
  .btn-dark:hover  { background: #2d2d4a; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(26,26,46,0.2); }
  .btn-blue  { background: var(--blue); color: white; }
  .btn-blue:hover  { background: var(--blue-dark); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(108,155,181,0.35); }
  .action-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; }

  /* OR DIVIDER */
  .or-divider {
    display: flex; align-items: center; gap: 12px;
    padding: 0 4px;
  }
  .or-line { flex: 1; height: 1px; background: var(--border); }
  .or-text  { font-size: 0.80rem; font-weight: 800; color: var(--text-muted); }

  /* GROUP INFO */
  .group-info { display: flex; align-items: center; gap: 14px; padding: 20px 22px 16px; }
  .group-avatar {
    width: 48px; height: 48px; border-radius: 14px;
    background: var(--blue-bg); color: var(--blue);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .group-avatar svg { width: 24px; height: 24px; }
  .group-name { font-size: 1rem; font-weight: 900; color: var(--text-primary); }
  .group-care { font-size: 0.80rem; color: var(--text-secondary); font-weight: 600; margin-top: 2px; }

  .divider { height: 1px; background: var(--border); margin: 0 22px; }

  /* INVITE */
  .invite-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 22px;
  }
  .invite-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-bottom: 3px; }
  .invite-code  { font-size: 0.88rem; font-weight: 800; color: var(--text-primary); letter-spacing: 0.02em; }

  .copy-btn {
    width: 36px; height: 36px; background: var(--blue-bg); border: 1px solid #c8dfe9;
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--blue); transition: all 0.2s; flex-shrink: 0;
  }
  .copy-btn:hover { background: var(--blue); color: white; }
  .copy-btn svg { width: 16px; height: 16px; }

  .invite-btn {
    width: calc(100% - 44px); margin: 0 22px 18px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 14px; background: var(--text-primary); color: white;
    border: none; border-radius: 13px;
    font-family: 'Nunito', sans-serif; font-size: 0.95rem; font-weight: 800;
    cursor: pointer; transition: all 0.2s; letter-spacing: 0.01em;
  }
  .invite-btn:hover { background: #2d2d4a; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(26,26,46,0.2); }
  .invite-btn svg { width: 18px; height: 18px; }

  /* MEMBERS */
  .members-list { display: flex; flex-direction: column; gap: 2px; }
  .member-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0; border-bottom: 1px solid var(--border);
  }
  .member-row:last-child { border-bottom: none; }
  .member-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.88rem; font-weight: 900; color: white;
    flex-shrink: 0; border: 2px solid var(--white);
    box-shadow: 0 2px 8px rgba(108,155,181,0.22);
  }
  .member-info  { flex: 1; min-width: 0; }
  .member-name-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .member-name  { font-size: 0.92rem; font-weight: 800; color: var(--text-primary); }
  .member-email { font-size: 0.76rem; color: var(--text-muted); font-weight: 600; }
  .badge-tu {
    font-size: 0.62rem; font-weight: 800; padding: 2px 7px;
    background: var(--blue-bg); color: var(--blue-darker);
    border: 1px solid #c8dfe9; border-radius: 99px; letter-spacing: 0.03em;
  }
  .badge-crown { color: #f59e0b; display: flex; align-items: center; }
  .badge-crown svg { width: 14px; height: 14px; fill: #fbbf24; stroke: #f59e0b; }
  .badge-rol {
    font-size: 0.70rem; font-weight: 800; padding: 4px 12px;
    background: var(--blue-bg); color: var(--blue-darker);
    border: 1px solid #c8dfe9; border-radius: 99px;
    white-space: nowrap; flex-shrink: 0;
  }

  /* ACTIVITY */
  .activity-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 4px; }
  .activity-cell { border-radius: 12px; padding: 16px 14px; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .activity-val   { font-size: 1.8rem; font-weight: 900; line-height: 1; }
  .activity-label { font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); text-align: center; }

  /* CONFIG */
  .config-list { display: flex; flex-direction: column; }
  .config-row {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 0; text-decoration: none; cursor: pointer;
    background: none; border: none; width: 100%;
    font-family: 'Nunito', sans-serif; transition: opacity 0.15s;
  }
  .config-row:hover { opacity: 0.75; }
  .config-icon {
    width: 34px; height: 34px; border-radius: 10px;
    background: var(--blue-bg); color: var(--blue);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .config-icon svg { width: 17px; height: 17px; }
  .logout-icon { background: #fff1f3; color: #e03b5a; }
  .config-label { flex: 1; font-size: 0.92rem; font-weight: 700; color: var(--text-primary); text-align: left; }
  .logout-label { color: #e03b5a; }
  .config-arrow { width: 16px; height: 16px; color: var(--text-muted); flex-shrink: 0; }
  .config-divider { height: 1px; background: var(--border); }

  /* TOAST */
  .toast {
    position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%) translateY(20px);
    background: var(--text-primary); color: white;
    font-family: 'Nunito', sans-serif; font-size: 0.82rem; font-weight: 700;
    padding: 10px 20px; border-radius: 99px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    white-space: nowrap; z-index: 200;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .toast.error { background: #e03b5a; }

  /* MODAL */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.45);
    z-index: 300; display: flex; align-items: flex-end; justify-content: center;
    padding: 0 0 20px;
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .modal-box {
    background: white; border-radius: 20px 20px 16px 16px;
    padding: 24px 24px 28px; width: 100%; max-width: 480px;
    box-shadow: 0 -8px 40px rgba(0,0,0,0.15);
    animation: slideUp 0.25s ease;
  }
  @keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .modal-title  { font-size: 1.1rem; font-weight: 900; color: var(--text-primary); }
  .modal-close  {
    width: 32px; height: 32px; border: none; background: var(--blue-bg);
    border-radius: 50%; cursor: pointer; color: var(--text-secondary);
    display: flex; align-items: center; justify-content: center;
  }
  .modal-close svg { width: 15px; height: 15px; }
  .modal-desc { font-size: 0.82rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 16px; }
  .modal-code-box {
    display: flex; align-items: center; justify-content: space-between;
    background: var(--blue-bg); border: 1.5px solid #c8dfe9; border-radius: 12px;
    padding: 14px 16px;
  }
  .modal-code-box span { font-size: 0.9rem; font-weight: 800; color: var(--text-primary); letter-spacing: 0.02em; word-break: break-all; }
  .modal-copy {
    width: 34px; height: 34px; flex-shrink: 0; margin-left: 10px;
    background: white; border: 1px solid #c8dfe9; border-radius: 9px;
    cursor: pointer; color: var(--blue);
    display: flex; align-items: center; justify-content: center; transition: all 0.2s;
  }
  .modal-copy:hover { background: var(--blue); color: white; }
  .modal-copy svg { width: 15px; height: 15px; }
</style>

<script define:vars={{ tieneGrupo }}>
  const toast     = document.getElementById('toast');
  const logoutBtn = document.getElementById('logoutBtn');

  function showToast(msg, isError = false) {
    toast.textContent = msg;
    toast.classList.toggle('error', isError);
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
  }

  // Logout
  logoutBtn.addEventListener('click', () => {
    document.cookie = "token=; path=/; max-age=0";
    window.location.href = '/login';
  });

  if (tieneGrupo) {
    // Copiar código
    const copyBtn  = document.getElementById('copyBtn');
    const copyIcon = document.getElementById('copyIcon');
    const invCode  = document.getElementById('inviteCode');

    copyBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(invCode.textContent ?? ''); }
      catch {
        const ta = document.createElement('textarea');
        ta.value = invCode.textContent ?? '';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); document.body.removeChild(ta);
      }
      copyIcon.innerHTML = `<polyline points="20 6 9 17 4 12"/>`;
      copyBtn.style.background = '#6C9BB5'; copyBtn.style.color = 'white';
      showToast('¡Código copiado!');
      setTimeout(() => {
        copyIcon.innerHTML = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>`;
        copyBtn.style.background = ''; copyBtn.style.color = '';
      }, 2000);
    });

    // Modal invitar
    const inviteBtn   = document.getElementById('inviteBtn');
    const inviteModal = document.getElementById('inviteModal');
    const modalClose  = document.getElementById('modalClose');
    const modalCopyBtn = document.getElementById('modalCopyBtn');
    const modalCode   = document.getElementById('modalCode');

    inviteBtn.addEventListener('click', () => { inviteModal.style.display = 'flex'; });
    modalClose.addEventListener('click', () => { inviteModal.style.display = 'none'; });
    inviteModal.addEventListener('click', (e) => { if (e.target === inviteModal) inviteModal.style.display = 'none'; });

    modalCopyBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(modalCode.textContent ?? ''); }
      catch {
        const ta = document.createElement('textarea');
        ta.value = modalCode.textContent ?? '';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); document.body.removeChild(ta);
      }
      showToast('¡Código copiado!');
    });

  } else {
    // ── CREAR GRUPO ──
    const crearBtn   = document.getElementById('crearBtn');
    const nombreInput = document.getElementById('nombreGrupo');
    const crearError  = document.getElementById('crearError');

    crearBtn.addEventListener('click', async () => {
      const nombre = nombreInput.value.trim();
      crearError.style.display = 'none';

      if (!nombre) {
        crearError.textContent = 'Por favor, escribe un nombre para el grupo.';
        crearError.style.display = 'block';
        return;
      }

      crearBtn.disabled = true;
      crearBtn.textContent = 'Creando...';

      try {
        const res = await fetch('/api/grupo/crear', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre })
        });
        const data = await res.json();

        if (!res.ok) {
          crearError.textContent = data.error || 'Error al crear el grupo.';
          crearError.style.display = 'block';
          crearBtn.disabled = false;
          crearBtn.textContent = 'Crear grupo';
          return;
        }

        // Actualizar cookie con nuevo token
        const expires = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toUTCString();
        document.cookie = `token=${data.token}; path=/; expires=${expires}; SameSite=Lax`;
        showToast('¡Grupo creado! Redirigiendo…');
        setTimeout(() => window.location.reload(), 1000);

      } catch {
        crearError.textContent = 'Error de conexión. Inténtalo de nuevo.';
        crearError.style.display = 'block';
        crearBtn.disabled = false;
        crearBtn.textContent = 'Crear grupo';
      }
    });

    // ── UNIRSE A GRUPO ──
    const unirseBtn   = document.getElementById('unirseBtn');
    const codigoInput = document.getElementById('codigoGrupo');
    const unirseError = document.getElementById('unirseError');

    unirseBtn.addEventListener('click', async () => {
      const codigo = codigoInput.value.trim();
      unirseError.style.display = 'none';

      if (!codigo) {
        unirseError.textContent = 'Por favor, introduce el código de invitación.';
        unirseError.style.display = 'block';
        return;
      }

      unirseBtn.disabled = true;
      unirseBtn.textContent = 'Uniéndose...';

      try {
        const res = await fetch('/api/grupo/unirse', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ codigo })
        });
        const data = await res.json();

        if (!res.ok) {
          unirseError.textContent = data.error || 'Error al unirse al grupo.';
          unirseError.style.display = 'block';
          unirseBtn.disabled = false;
          unirseBtn.textContent = 'Unirse al grupo';
          return;
        }

        // Actualizar cookie con nuevo token
        const expires = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toUTCString();
        document.cookie = `token=${data.token}; path=/; expires=${expires}; SameSite=Lax`;
        showToast('¡Te has unido! Redirigiendo…');
        setTimeout(() => window.location.reload(), 1000);

      } catch {
        unirseError.textContent = 'Error de conexión. Inténtalo de nuevo.';
        unirseError.style.display = 'block';
        unirseBtn.disabled = false;
        unirseBtn.textContent = 'Unirse al grupo';
      }
    });
  }
</script>

</body>
</html>