---
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';
import { query } from '../lib/db.js';
 
// Si el usuario no ha iniciado sesión, mandarlo al login
const token = Astro.cookies.get('token')?.value;
if (!token) return Astro.redirect('/login');
 
// Decodificar el token y sacar el grupo del usuario
const payload  = JSON.parse(Buffer.from(token, 'base64').toString());
const grupo_id   = payload.grupo_id;
const usuario_id = payload.id;
const nombre     = payload.nombre;
 
// Cargar todas las notas del grupo desde la base de datos
let notas = [];
if (grupo_id) {
  const resultado = await query(
    `SELECT
       n.id,
       n.titulo,
       n.contenido,
       n.creado_por,
       u.nombre AS autor,
       TO_CHAR(n.updated_at, 'DD/MM/YYYY') AS fecha
     FROM notas n
     LEFT JOIN usuarios u ON u.id = n.creado_por
     WHERE n.grupo_id = $1
     ORDER BY n.updated_at DESC`,
    [grupo_id]
  );
  notas = resultado.rows;
}
---

<!DOCTYPE html>
<html lang="es">
<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Kinvia · Notas</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

</head>
<body class="min-h-screen flex flex-col bg-[#faf8ff] text-[#1a1a2e] font-[Nunito]">
<main class="flex-1 overflow-y-auto pb-[90px]">

<!-- HEADER -->

<header class="relative bg-[#6C9BB5] px-6 pt-8 pb-9 overflow-hidden">
<div class="absolute w-[360px] h-[360px] rounded-full bg-white/5 -top-[120px] -right-[90px]"></div>
<div class="absolute w-[240px] h-[240px] rounded-full bg-white/5 -bottom-[70px] -left-[60px]"></div>

<h1 class="text-[1.45rem] font-black text-white">
Notas
</h1>

<p class="text-[0.88rem] font-semibold text-white/70 mt-1">
Notas compartidas del grupo
</p>

</header>

<!-- CONTENT -->

<div class="p-5 flex flex-col gap-4">

<!-- CREAR NOTA -->

<section class="bg-white rounded-2xl border border-[#e8e0f5] shadow p-5">

<h2 class="text-sm font-black mb-3">
Crear nueva nota
</h2>

<input
placeholder="Título"
class="w-full border border-[#e8e0f5] rounded-xl p-3 mb-3 text-sm"
/>

<textarea
placeholder="Escribe una nota..."
class="w-full border border-[#e8e0f5] rounded-xl p-3 mb-3 text-sm h-24 resize-none"
></textarea>

<button
class="w-full bg-[#6C9BB5] text-white font-extrabold rounded-xl py-3 text-sm hover:opacity-90"
>
