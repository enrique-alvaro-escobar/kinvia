---
// src/pages/login.astro
import LoginPanel from '../components/LoginPanel.astro';
import LoginForm  from '../components/LoginForm.astro';
import '../styles/global.css';

---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kinvia — Iniciar sesión</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-[#faf8ff] text-[#1a1a2e] font-[Nunito]" style="font-family:'Nunito',sans-serif;">

  <div class="min-h-screen grid grid-cols-1 grid-rows-[auto_1fr] lg:grid-cols-[52%_48%] lg:grid-rows-1 lg:h-screen">

    <!-- Panel izquierdo — solo desktop, se renderiza primero en el DOM -->
    <LoginPanel />

<!-- Header mobile — solo visible en móvil/tablet -->
<div class="relative lg:hidden bg-[#6C9BB5] px-6 py-6 flex flex-col items-center gap-4 text-center order-first lg:order-none overflow-hidden">

  <!-- Pompas decorativas -->
  <div class="absolute w-[40vw] h-[40vw] rounded-full bg-white/[.04] -top-[10vw] -right-[10vw]"></div>
  <div class="absolute w-[30vw] h-[30vw] rounded-full bg-white/[.03] -bottom-[8vw] -left-[8vw]"></div>
  <div class="absolute w-[20vw] h-[20vw] rounded-full bg-white/[.02] top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2"></div>

  <div class="relative z-10 flex items-center gap-1">
    <div class="w-18 h-18 flex items-center justify-center">
      <img src="/public/kinvia-logo-letter-white.webp" alt="Kinvia" class="w-full h-full object-contain" />
    </div>
    <!-- <span class="text-[22px] font-black text-white tracking-wide">Kinvia</span> -->
  </div>
  <p class="relative z-10 text-sm font-medium text-white/70 leading-relaxed max-w-[280px]">
    Coordina el cuidado de tu familiar con toda la familia en un solo lugar.
  </p>
</div>

    <!-- Formulario -->
    <LoginForm />

  </div>

</body>
</html>